# Required by the app. Copy this file to .env and fill in real values locally.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
HENRIKDEV_API_KEY=your-henrikdev-api-key
ADMIN_API_KEY=replace-with-a-long-random-value

# Optional; used only by `pnpm smoke:profile`.
VALORANT_OPERATOR_PUUID=
VALORANT_REGION=na
VALORANT_PLATFORM=pc
